{
  "name": "almadocx",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm --filter @almadocx/core test:coverage && pnpm --filter @almadocx/canvas test:coverage",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "playground": "pnpm --filter @almadocx/playground dev",
    "harness": "pnpm --filter @almadocx/harness test",
    "format": "prettier -w ."
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
